# Local/company backend
LOKALBLICK_HOST=127.0.0.1
LOKALBLICK_PORT=8787

# Server-side geocoding. Keep the real key secret.
# Same provider/key family as Velovista.
ORS_API_KEY=

# Client-side CARTO basemap key.
# May use the same CARTO account/key as Velovista.
VITE_CARTO_API_KEY=

# Optional: absolute path to the backend-owned coordinate overlay.
# Default: %USERPROFILE%/Lokalblick/coordinates.json on Windows.
LOKALBLICK_COORDINATES_PATH=

# Optional comma-separated browser origins allowed to call the local API.
# Leave empty for the same-origin company runtime.
LOKALBLICK_ALLOWED_ORIGINS=
